# Copie para .env e preencha localmente. NUNCA versionar .env com valores reais.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM ---
# gemini | mock | mock_fail  (mock é o default — testes e CI nunca chamam API externa)
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# --- Tools / monitoring ---
MONITORING_BASE_URL=http://localhost:8081
MONITORING_ENABLED=true
MONITORING_TIMEOUT_SECONDS=3.0
MONITORING_MAX_RETRIES=2

# inprocess | mcp
TOOLS_TRANSPORT=inprocess

# --- Low-code / notificações ---
# URL do webhook do n8n (ver n8n/incidentai-alert.json). Vazio = notificação desabilitada.
N8N_WEBHOOK_URL=
NOTIFY_MIN_SEVERITY=high

# Credenciais da UI do n8n (docker-compose.low-code.yml, perfil "low-code").
# Obrigatório antes de:
#   docker compose -f docker-compose.yml -f docker-compose.low-code.yml \
#     --profile low-code up -d
# Sem senha o container recusa subir (fail-closed) em vez de expor a UI sem
# autenticação real.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# --- Grafo ---
MAX_ITERATIONS=3
RECURSION_LIMIT=25
LOW_CONFIDENCE_THRESHOLD=0.4
